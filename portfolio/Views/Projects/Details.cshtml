@model ProjectDetails
@{
    ViewData["Title"] = Model.Project.Title;

    // Turn a YouTube link into the address of an embeddable player.
    var videoId = System.Text.RegularExpressions.Regex.Match(Model.Project.VideoUrl ?? "", @"(?:v=|youtu\.be/|shorts/)([A-Za-z0-9_-]{11})").Groups[1].Value;
}

<p class="mb-1">
    <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Project.CourseId" class="badge text-bg-dark text-decoration-none">@Model.Project.CourseCode</a>
    <span class="text-muted small">@Model.Project.CourseTitle</span>
</p>
<h1 class="mb-1">@Model.Project.Title</h1>
<p class="text-muted">Completed @Model.Project.CompletedOn.ToString("yyyy-MM-dd")</p>
<p>@Model.Project.Summary</p>

@if (Model.Images.Count > 0)
{
    <h2 class="h5 mt-4">Screenshots</h2>
    <div class="row g-3">
        @foreach (var image in Model.Images)
        {
            <div class="col-12 col-md-6">
                <img src="@image.ImageUrl" alt="@Model.Project.Title" class="img-fluid rounded shadow-sm" />
            </div>
        }
    </div>
}

@if (videoId != "")
{
    <h2 class="h5 mt-4">Demo video</h2>
    <iframe width="560" height="315" src="https://www.youtube.com/embed/@videoId" title="Project demo" allowfullscreen></iframe>
}

<div class="mt-4">
    <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Project.CourseId" class="btn btn-link px-0">Back to the course</a>
</div>