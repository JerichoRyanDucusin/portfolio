@model LoginForm
@{
    ViewData["Title"] = "Sign in";
}

<div class="card card-body mx-auto" style="max-width:26rem">
    <h1 class="h3 mb-3"><i class="bi bi-lock"></i> Editor sign-in</h1>

    <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <div class="mb-3">
            <label asp-for="Username" class="form-label">Username</label>
            <input asp-for="Username" class="form-control" autocomplete="username" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">Password</label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">Sign in</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}