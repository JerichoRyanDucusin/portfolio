@{
    int code = ViewBag.Code ?? 404;
    ViewData["Title"] = code == 404 ? "Page not found" : "Something went wrong";
}

<div class="text-center py-5">
    <i class="bi bi-compass display-1 text-muted"></i>
    @if (code == 404)
    {
        <h1 class="mt-3">We couldn't find that page</h1>
        <p class="text-muted">The page or item you asked for doesn't exist. It may have been deleted, or the link is wrong.</p>
    }
    else
    {
        <h1 class="mt-3">Something went wrong</h1>
        <p class="text-muted">The server could not complete the request (code @code).</p>
    }
    <a asp-controller="Courses" asp-action="Index" class="btn btn-primary"><i class="bi bi-house"></i> Back to the portfolio</a>
</div>