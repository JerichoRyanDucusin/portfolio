@model ProjectForm
@{
    ViewData["Title"] = "Edit a project";
}

<h1 class="mb-3">Edit a project</h1>

<form id="project-form" asp-action="Edit" method="post" class="card card-body" style="max-width:42rem">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <input type="hidden" asp-for="ProjectId" />

    <partial name="_Fields" model="Model" />

    <div>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save changes</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_FormScripts" />
}