@model List<Project>
@{
    ViewData["Title"] = "Editor: projects";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Editor: projects</h1>
        <p class="text-muted mb-0">@Model.Count projects</p>
    </div>
    <div>
        <a asp-controller="ManageCourses" asp-action="Index" class="btn btn-outline-secondary">Courses</a>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Add a project</a>
    </div>
</div>

<table class="table table-striped align-middle">
    <thead class="table-dark">
        <tr>
            <th>Course</th>
            <th>Title</th>
            <th>Completed</th>
            <th style="width:14rem"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var project in Model)
        {
            <tr>
                <td>@project.CourseCode</td>
                <td>@project.Title</td>
                <td>@project.CompletedOn.ToString("yyyy-MM-dd")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@project.ProjectId" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i> Edit</a>
                    <a asp-action="Delete" asp-route-id="@project.ProjectId" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>