@model Project
@{
    ViewData["Title"] = "Delete a project";
}

<h1 class="mb-3">Delete a project</h1>

<div class="card card-body" style="max-width:36rem">
    <p>Are you sure you want to delete this project? Its images are deleted with it.</p>
    <dl class="row mb-2">
        <dt class="col-4">Course</dt>
        <dd class="col-8">@Model.CourseCode</dd>
        <dt class="col-4">Title</dt>
        <dd class="col-8">@Model.Title</dd>
        <dt class="col-4">Completed</dt>
        <dd class="col-8">@Model.CompletedOn.ToString("yyyy-MM-dd")</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.ProjectId" method="post">
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Delete</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
</div>